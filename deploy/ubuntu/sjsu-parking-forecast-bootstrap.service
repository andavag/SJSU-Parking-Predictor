[Unit]
Description=Create initial SJSU Parking forecast models
After=mysql.service

[Service]
Type=oneshot
User=sjsu-parking
Group=sjsu-parking
WorkingDirectory=/srv/sjsu-parking/forecasting
Environment=PYTHONUNBUFFERED=1
Environment=PARKING_FORECAST_ARTIFACT_DIR=/srv/sjsu-parking/forecasting/artifacts
EnvironmentFile=/etc/sjsu-parking/collector.env
ExecStart=/srv/sjsu-parking/forecasting-venv/bin/python -m parking_forecast.train --bootstrap
TimeoutStartSec=20min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/sjsu-parking/forecasting
