[Unit]
Description=Refresh SJSU Parking Kalman forecasting state
After=mysql.service sjsu-parking-forecast-worker.service

[Service]
Type=oneshot
User=sjsu-parking
Group=sjsu-parking
WorkingDirectory=/srv/sjsu-parking/forecasting
Environment=PYTHONUNBUFFERED=1
Environment=PARKING_FORECAST_ARTIFACT_DIR=/srv/sjsu-parking/forecasting/artifacts
EnvironmentFile=/etc/sjsu-parking/collector.env
ExecStart=/srv/sjsu-parking/forecasting-venv/bin/python -m parking_forecast.refresh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/sjsu-parking/forecasting
