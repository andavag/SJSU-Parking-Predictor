import { describe, expect, it } from "vitest";
import { initialTrackerState, transition, WEST_GARAGE, type TrackerState } from "./parkingTrackerState";

const ID = "123e4567-e89b-42d3-a456-426614174000";
const t = Date.parse("2026-10-20T08:00:00Z");
const step = (state: TrackerState, event: Parameters<typeof transition>[1]) => transition(state, event, () => ID);

describe("West Garage tracker", () => {
  it("uses the exact phase-one region configuration", () => {
    expect(WEST_GARAGE).toMatchObject({ latitude: 37.3316667, longitude: -121.8827222, entryRadiusMeters: 100, exitRadiusMeters: 160, trackingConfigVersion: 1 });
  });

  it("completes one drive-in and walk-out estimate, ignoring return and departure", () => {
    let state = step(initialTrackerState(), { type: "enable", at: t }).state;
    state = step(state, { type: "outer_enter", at: t + 1_000, evidence: "motion" }).state;
    state = step(state, { type: "inner_enter", at: t + 30_000 }).state;
    const completed = step(state, { type: "outer_exit", at: t + 9 * 60_000 + 30_000, evidence: "motion" });
    expect(completed.visit).toMatchObject({ clientVisitId: ID, elapsedSeconds: 540, confidence: "high" });
    state = completed.state;
    state = step(state, { type: "outer_enter", at: t + 4 * 60 * 60_000 }).state;
    state = step(state, { type: "inner_enter", at: t + 4 * 60 * 60_000 + 20_000 }).state;
    expect(step(state, { type: "outer_exit", at: t + 4 * 60 * 60_000 + 80_000 }).visit).toBeUndefined();
  });

  it("discards drive-throughs and ignores exits without a session", () => {
    let state = step(initialTrackerState(), { type: "enable", at: t }).state;
    expect(step(state, { type: "outer_exit", at: t + 1_000 }).visit).toBeUndefined();
    state = step(state, { type: "outer_enter", at: t + 2_000, evidence: "speed" }).state;
    state = step(state, { type: "inner_enter", at: t + 10_000 }).state;
    expect(step(state, { type: "outer_exit", at: t + 70_000, evidence: "speed" }).state).toMatchObject({ kind: "discarded", reason: "drive_through" });
  });

  it("labels speed-only estimates low confidence and discards exits without walking evidence", () => {
    let state = step(initialTrackerState(), { type: "enable", at: t }).state;
    state = step(state, { type: "outer_enter", at: t + 1_000, evidence: "speed" }).state;
    state = step(state, { type: "inner_enter", at: t + 10_000 }).state;
    expect(step(state, { type: "outer_exit", at: t + 180_000 }).state).toMatchObject({ kind: "discarded", reason: "uncertain" });
    expect(step(state, { type: "outer_exit", at: t + 180_000, evidence: "speed" }).visit?.confidence).toBe("low");
  });

  it("deduplicates callbacks, rejects out-of-order timestamps, and recovers active state", () => {
    let state = step(initialTrackerState(), { type: "enable", at: t }).state;
    state = step(state, { type: "outer_enter", at: t + 1_000, evidence: "speed" }).state;
    state = step(state, { type: "inner_enter", at: t + 10_000 }).state;
    expect(step(state, { type: "inner_enter", at: t + 10_000 }).state).toEqual(state);
    expect(step(state, { type: "outer_exit", at: t + 5_000, evidence: "motion" }).state).toEqual(state);
    const restored = JSON.parse(JSON.stringify(state)) as TrackerState;
    const completed = step(restored, { type: "outer_exit", at: t + 180_000, evidence: "motion" });
    expect(completed.visit?.confidence).toBe("medium");
    expect(step(completed.state, { type: "outer_exit", at: t + 181_000, evidence: "motion" }).visit).toBeUndefined();
  });

  it("buffers an inner callback briefly when it arrives before the outer callback", () => {
    let state = step(initialTrackerState(), { type: "enable", at: t }).state;
    state = step(state, { type: "inner_enter", at: t + 10_000 }).state;
    expect(state).toMatchObject({ kind: "monitoring", pendingInnerAt: t + 10_000 });
    state = step(state, { type: "outer_enter", at: t + 20_000, evidence: "motion" }).state;
    expect(state).toMatchObject({ kind: "active", startedAt: t + 10_000 });
  });

  it("does not buffer an inner entry reported after an outer exit", () => {
    let state = step(initialTrackerState(), { type: "enable", at: t }).state;
    state = step(state, { type: "outer_exit", at: t + 5_000 }).state;
    state = step(state, { type: "inner_enter", at: t + 10_000 }).state;
    expect(state).toMatchObject({ kind: "monitoring" });
    expect("pendingInnerAt" in state).toBe(false);
  });

  it("expires stale sessions and stays safe when disabled", () => {
    let state = step(initialTrackerState(), { type: "enable", at: t }).state;
    state = step(state, { type: "outer_enter", at: t + 1_000, evidence: "motion" }).state;
    state = step(state, { type: "inner_enter", at: t + 2_000 }).state;
    expect(step(state, { type: "expire", at: t + 61 * 60_000 }).state).toMatchObject({ kind: "discarded", reason: "stale" });
    state = step(state, { type: "disable", at: t + 3_000 }).state;
    expect(step(state, { type: "outer_exit", at: t + 180_000, evidence: "motion" }).visit).toBeUndefined();
  });
});
