{
  "name": "sjsu-parking-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=./certificates/incommon-rsa-ov-ssl-ca-3.pem node --env-file-if-exists=.env --use-system-ca --import tsx --watch src/index.ts",
    "start": "NODE_EXTRA_CA_CERTS=./certificates/incommon-rsa-ov-ssl-ca-3.pem node --env-file-if-exists=.env --use-system-ca --import tsx src/index.ts",
    "collect": "NODE_EXTRA_CA_CERTS=./certificates/incommon-rsa-ov-ssl-ca-3.pem node --env-file-if-exists=.env --use-system-ca --import tsx src/collector.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:predictions": "node --env-file-if-exists=.env --import tsx scripts/verify-predictions.ts",
    "visits:admin": "node --env-file-if-exists=.env --import tsx scripts/parking-visit-admin.ts"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "luxon": "^3.7.2",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.0.15",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
